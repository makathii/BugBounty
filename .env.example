# BugBounty Platform Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED: Django Security
# =============================================================================
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secure-secret-key-here

# NEVER set to True in production — exposes stack traces and disables security checks
DJANGO_DEBUG=False

# Comma-separated list of hostnames the server will accept requests for
ALLOWED_HOSTS=bugbounty.example.com,api.bugbounty.example.com,localhost

# =============================================================================
# REQUIRED IN PRODUCTION: HTTPS / Cookie Security
# =============================================================================
DJANGO_SECURE_SSL=True
DJANGO_SECURE_COOKIES=True
DJANGO_HSTS=True

# =============================================================================
# OPTIONAL: Google reCAPTCHA (for production)
# =============================================================================
# Get your keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# =============================================================================
# REQUIRED IN PRODUCTION: Email Configuration
# =============================================================================
# EMAIL_BACKEND options: "smtp" (production), "console" (dev, default), "locmem" (tests)
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=no-reply@bugbounty.example.com

# =============================================================================
# OPTIONAL: Production Database
# =============================================================================
# DATABASE_URL=postgres://user:password@host:5432/dbname

# =============================================================================
# OPTIONAL: CSP Reporting
# =============================================================================
# Set to True during rollout to collect violations without blocking
CSP_REPORT_ONLY=False
# Endpoint to receive CSP violation reports (e.g. https://your-csp-report-uri.example.com)
CSP_REPORT_URI=

# =============================================================================
# OPTIONAL: External Services
# =============================================================================
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Performance / operations ---
# Persistent DB connections (seconds). 0 disables; use 0 behind a transaction-mode pooler
# (and set DB_DISABLE_SERVER_SIDE_CURSORS=True).
# DB_CONN_MAX_AGE=60
# Shared cache for throttling + leaderboard. Empty/unset -> per-process memory cache.
# REDIS_URL=redis://redis:6379/1
# Security audit log retention for `manage.py purge_audit_logs` (days; 0 = keep forever).
# AUDIT_LOG_RETENTION_DAYS=365
# Celery broker (background tasks). Default in compose: redis://redis:6379/0.
# Set to empty to run tasks inline in the web process (no worker needed).
# CELERY_BROKER_URL=redis://redis:6379/0
