# BugBounty environment variables.
#
#   cp .env.example .env     then run:  docker compose up --build
#
# As shipped, this file is a working LOCAL-DEVELOPMENT setup: the only value you must fill in
# is DJANGO_SECRET_KEY. Everything else has a sensible default and is listed so you know it exists.
# Production-only settings are at the bottom, commented out.

# =============================================================================
# Required
# =============================================================================
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# =============================================================================
# Database (the defaults match the postgres container; change them to harden)
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bug_bounty_db

# =============================================================================
# Google reCAPTCHA v2 ("I'm not a robot")
# =============================================================================
# The SITE key (frontend) and SECRET key (backend) must be the two halves of the SAME pair,
# otherwise registration fails with "Invalid captcha, please try again."
#
# Local, no verification (simplest): leave RECAPTCHA_SECRET_KEY empty. The widget still shows.
# Local, with verification: Google's public test pair, which always passes:
#   REACT_APP_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Real keys: https://www.google.com/recaptcha/admin (type v2 checkbox, domain: localhost)
RECAPTCHA_SECRET_KEY=
REACT_APP_RECAPTCHA_SITE_KEY=

# =============================================================================
# Email (verification links, password resets)
# =============================================================================
# Local: leave the EMAIL_* lines out. docker-compose starts Mailpit and every email lands in its
# inbox at http://localhost:8025 (that is where the "verify your email" link is).
# Do NOT paste SendGrid/other credentials here for local use; they would be tried against Mailpit.
#
# Real SMTP (staging/production), e.g. SendGrid:
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=no-reply@your-domain.example
#
# Base URL used in email links (verification, password reset). Default: http://localhost:3000
# FRONTEND_URL=https://app.your-domain.example

# =============================================================================
# Rate limits (defaults are strict; relax them while developing)
# =============================================================================
LOGIN_THROTTLE_RATE=30/min
REGISTER_THROTTLE_RATE=20/min

# =============================================================================
# Optional tuning (defaults shown)
# =============================================================================
# Persistent DB connections in seconds; 0 disables (use 0 behind a transaction-mode pooler).
# DB_CONN_MAX_AGE=60
# Shared cache for throttling + leaderboard (compose default: redis://redis:6379/1).
# Set REDIS_URL= (empty) to use the in-process cache instead.
# REDIS_URL=redis://redis:6379/1
# Celery broker (compose default: redis://redis:6379/0). Empty = run tasks inline, no worker.
# CELERY_BROKER_URL=redis://redis:6379/0
# Security audit log retention for `manage.py purge_audit_logs` (days; 0 = keep forever).
# AUDIT_LOG_RETENTION_DAYS=365

# =============================================================================
# Production only
# =============================================================================
# These are read by the Django settings but are NOT forwarded by docker-compose.yml: set them in
# your real deployment environment. Turn the three SECURE/HSTS flags on only when you serve HTTPS,
# otherwise every request is redirected to https and cookies are never sent.
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=bugbounty.example.com,api.bugbounty.example.com
# DJANGO_SECURE_SSL=True
# DJANGO_SECURE_COOKIES=True
# DJANGO_HSTS=True
# DATABASE_URL=postgres://user:password@host:5432/dbname
# CSP_REPORT_ONLY=False        # True during rollout: collect violations without blocking
# CSP_REPORT_URI=https://your-csp-report-uri.example.com
