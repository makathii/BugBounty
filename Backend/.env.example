# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=bug_bounty_db
DATABASE_URL=postgres://postgres:your-db-password@db:5432/bug_bounty_db

# reCAPTCHA v2 — get keys from https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# OAuth (optional — only needed if OAuth login is enabled)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Email (set to your SMTP provider in production)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
